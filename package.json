{
  "name": "dsh-stars",
  "version": "0.4.0",
  "type": "module",
  "description": "DSH 插件：把 GitHub star 归进 Lists、批量归类、跟踪自上次查看后的变更。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "stars"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "assets",
    "scripts",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check src/github.js && node --check src/store.js && node --check src/classify.js && node --check src/organize.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "author": "whiplashf",
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whiplashf/dsh-stars.git"
  },
  "homepage": "https://github.com/whiplashf/dsh-stars#readme",
  "bugs": {
    "url": "https://github.com/whiplashf/dsh-stars/issues"
  }
}
